{
  "manifest_version": 3,
  "name": "PII Copy Shield",
  "version": "1.0.0",
  "description": "Replaces detected personal information with placeholders before it reaches the clipboard.",
  "icons": {
    "128": "PII Shield.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "PII Copy Shield",
    "default_icon": {
      "128": "PII Shield.png"
    },
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/detector.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "pii-copy-shield@local",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}